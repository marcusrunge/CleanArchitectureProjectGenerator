<?xml version="1.0" encoding="utf-8"?>
<PackageManifest
    Version="2.0.0"
    xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
    xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">

	<Metadata>
		<Identity
			Id="MarcusRunge.CleanArchitectureProjectGenerator.05ee75c8-d9b3-4d12-892d-314574466705"
			Version="1.4.5"
			Language="en-US"
			Publisher="Marcus Runge" />

		<DisplayName>Clean Architecture Project Generator</DisplayName>

		<Description xml:space="preserve">A Visual Studio extension that generates modular Clean Architecture projects based on a predefined structure.</Description>

		<Icon>Resources\CleanArchitectureProjectGenerator.png</Icon>

		<Preview>true</Preview>

		<Tags>clean architecture, project template, project generator, scaffolding, dotnet</Tags>
	</Metadata>

	<Installation>
		<InstallationTarget
			Id="Microsoft.VisualStudio.Community"
			Version="[17.0,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>

		<InstallationTarget
			Id="Microsoft.VisualStudio.Pro"
			Version="[17.0,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>

		<InstallationTarget
			Id="Microsoft.VisualStudio.Enterprise"
			Version="[17.0,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
	</Installation>

	<Dependencies>
		<Dependency
			Id="Microsoft.Framework.NDP"
			DisplayName="Microsoft .NET Framework"
			Version="[4.8,)"
			d:Source="Manual" />
	</Dependencies>

	<Prerequisites>
		<Prerequisite
			Id="Microsoft.VisualStudio.Component.CoreEditor"
			DisplayName="Visual Studio core editor"
			Version="[17.0,)" />
	</Prerequisites>

	<Assets>
		<Asset
			Type="Microsoft.VisualStudio.VsPackage"
			Path="|%CurrentProject%;PkgdefProjectOutputGroup|"
			d:Source="Project"
			d:ProjectName="%CurrentProject%" />

		<Asset
			Type="Microsoft.VisualStudio.MefComponent"
			Path="|%CurrentProject%|"
			d:Source="Project"
			d:ProjectName="%CurrentProject%" />

		<Asset
			Type="Microsoft.VisualStudio.ProjectTemplate"
			Path="Resources\CleanArchitectureModule.zip" />
	</Assets>
</PackageManifest>